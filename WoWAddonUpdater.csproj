<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>WoWAddonUpdater</AssemblyName>
    <RootNamespace>WoWAddonUpdater</RootNamespace>
    <Version>0.3.1</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- `dotnet publish -c Release` produces one small WoWAddonUpdater.exe
         (needs the .NET 10 Desktop Runtime, which the SDK includes). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <!-- Built-in copy of the known-addons list, used when GitHub can't be reached. -->
  <ItemGroup>
    <EmbeddedResource Include="catalog.json" LogicalName="catalog.json" />
    <!-- Window/taskbar icon (the exe's own icon comes from ApplicationIcon). -->
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <!-- Lets the code know which variant it is, so each one updates itself from the matching release file. -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <DefineConstants>$(DefineConstants);SELF_CONTAINED</DefineConstants>
  </PropertyGroup>

</Project>
